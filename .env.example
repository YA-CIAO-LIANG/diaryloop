# Copy to .env.local and fill in. Never commit .env.local.
# Production values live in Vercel; set secrets with
# `bash scripts/set-secret.sh NAME` (hidden input), never by pasting.

# Supabase. Leave both empty to run without accounts.
NEXT_PUBLIC_SUPABASE_URL=
# The publishable key (sb_publishable_…): public, used in the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The secret key (sb_secret_…). Server only. Deleting accounts, plans.
SUPABASE_SERVICE_ROLE_KEY=
# Admin accounts, comma-separated Google emails.
ADMIN_EMAILS=

# Local development without Supabase: `npm run dev:memory` sets
# DATA_STORE=memory (in-memory data and test sign-in; never on Vercel).
DATA_STORE=

# Public contact email on the legal pages (D16). Empty: "via GitHub".
NEXT_PUBLIC_CONTACT_EMAIL=
